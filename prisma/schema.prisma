generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Attendee {
  id                 String       @id @default(uuid())
  registrationId     String       @unique // e.g. INSP26-0001
  fullName           String
  preferredName      String?
  gender             String
  ageGroup           String
  phone              String
  email              String       @unique
  location           String       // City/State/Country
  attendingAs        String
  company            String?
  jobTitle           String?
  industry           String?
  experienceYears    String?
  source             String?      // Marketing attribution
  expectations       String?
  communicationConsent Boolean      @default(false)
  mediaRelease       Boolean      @default(false)
  conductAgreement   Boolean      @default(false)
  qrCodeString       String       @unique
  status             String       @default("PENDING") // PENDING, CHECKED_IN
  paymentStatus      String       @default("UNPAID") // PAID, UNPAID, WAIVED
  certificateSent    Boolean      @default(false)
  seatId             String?      @unique
  seat               Seat?        @relation(fields: [seatId], references: [id])
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attendance         Attendance?
  feedback           Feedback[]
  messageLogs        MessageLog[]
}

model Attendance {
  id          String   @id @default(uuid())
  attendeeId  String   @unique
  attendee    Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  checkinTime DateTime @default(now())
  checkedBy   String?  // User.id who checked them in
}

model Speaker {
  id          String   @id @default(uuid())
  name        String
  profile     String?
  topic       String
  bio         String?
  contact     String?
  sessionTime String?
  createdAt   DateTime @default(now())
}

model Sponsor {
  id            String   @id @default(uuid())
  company       String
  package       String
  status        String   @default("PENDING")
  logoUrl       String?
  contactPerson String?
  createdAt     DateTime @default(now())
}

model Feedback {
  id               String   @id @default(uuid())
  attendeeId       String
  attendee         Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  experienceRating Int
  speakerRating    Int
  comments         String?
  createdAt        DateTime @default(now())
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("VOLUNTEER") // SUPER_ADMIN, EVENT_ADMIN, REGISTRATION_OFFICER, CHECK_IN_OFFICER, COMMUNICATIONS_OFFICER, ANALYTICS_VIEWER
  isActive  Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
}

model Section {
  id       String @id @default(uuid())
  name     String @unique // e.g., VIP, Regular, Balcony
  capacity Int
  seats    Seat[]
}

model Seat {
  id         String    @id @default(uuid())
  sectionId  String
  section    Section   @relation(fields: [sectionId], references: [id])
  row        String
  number     String
  attendee   Attendee?
  @@unique([sectionId, row, number])
}

model MessageLog {
  id         String   @id @default(uuid())
  attendeeId String
  attendee   Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  type       String   // WHATSAPP or EMAIL
  status     String   // SENT, FAILED, DELIVERED, READ
  content    String?
  timestamp  DateTime @default(now())
}

model Volunteer {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  phone      String
  department String
  assignment String?
  performance String?
  createdAt  DateTime @default(now())
}
